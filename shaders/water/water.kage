//kage:unit pixels
package main

var Counter int
var TankRect vec4 // x, y, x1, y2
var TankSize vec2 //width, height of the fish tank

func Fragment(dstCoord vec4, texCoord vec2, _ vec4) vec4 {
    floatCounter := float(Counter) * 0.009
    // Get original color first
    color := imageSrc0At(texCoord)

    // Check if we're inside the fish tank bounds

    org := imageDstOrigin()

    tankRect := TankRect
    tankRect.xy += org
    tankRect.zw += org

    xCheck := dstCoord.x >= tankRect.x && dstCoord.x <= tankRect.z
    yCheck := dstCoord.y >= tankRect.y && dstCoord.y <= tankRect.w

    if !xCheck || !yCheck{
        return color
    }

    // Convert to tank-relative coordinates (0-1 within tank)
    tankTexCoord := vec2(
        (dstCoord.x - TankRect.x+960) / TankRect.x+960,
        (dstCoord.y - TankRect.y) / TankRect.y,
    )

    // Create gentle wave distortion using tank coordinates
    wave1 := sin(tankTexCoord.y * 1000 + floatCounter * 1.2) * 0.002
    wave2 := cos(tankTexCoord.x * 9 + floatCounter * 0.8) * 0.001
    wave3 := sin(tankTexCoord.x * 100 + floatCounter * 1.5) * 0.0015

    // Combine waves for more natural movement
    waveOffset := vec2(wave1 + wave3, wave2)

    // Sample texture with wave distortion
    color = imageSrc0At(texCoord + waveOffset)

    if color.a > 0 {
        // Create caustics pattern using tank coordinates
        causticX := sin(tankTexCoord.x * 25.0 + floatCounter * 2.0) * 0.5 + 0.5
        causticY := sin(tankTexCoord.y * 20.0 + floatCounter * 1.5) * 0.5 + 0.5
        causticZ := cos(tankTexCoord.x * 18.0 + tankTexCoord.y * 15.0 + floatCounter * 1.8) * 0.5 + 0.5

        // Combine caustics for complex pattern
        caustics := (causticX * causticY + causticZ) * 0.5
        caustics = pow(caustics, 3.0) * 0.15  // Make sharper, more realistic



        // Apply water tint with subtle animation
        tintStrength := 0.6 + 0.2 * sin(floatCounter * 0.3)
        waterTint := vec3(0.75, 0.85, 1.0) * tintStrength

        // Blend original color with water effects
        color.rgb = mix(color.rgb, color.rgb * waterTint, 0.25)

        // Add caustics as additive light
        color.rgb += vec3(0.8, 0.9, 1.0) * caustics

        // Subtle depth darkening (deeper = slightly darker)
        depthDarkening := 1.0 - (tankTexCoord.y * 0.1)
        color.rgb *= depthDarkening

        // Add some shimmer On surfaces
        shimmer := sin(tankTexCoord.x * 40.0 + floatCounter * 3.0) *
                  cos(tankTexCoord.y * 35.0 + floatCounter * 2.5) * 0.02
        color.rgb += vec3(0.9, 0.95, 1.0) * max(shimmer, 0.0)
    }

    return color
}