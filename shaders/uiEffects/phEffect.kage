//kage:unit pixels
package main


var Point vec2
var Radius float
var PHValue float


func Fragment(dstCoord vec4, texCoord vec2, _ vec4) vec4 {
	color := imageSrc0UnsafeAt(texCoord)

    //inRadius := distance(dstCoord.xy, Point) < Radius



if color.a > 0 {
		//Map pH values to colors (standard pH color scale)
		//pH 0-14 scale: Red (acidic) -> Yellow -> Green (neutral) -> Blue -> Purple (basic)

		phColor := vec3(1.0, 1.0, 1.0) // Default white

		// Clamp pH to realistic range
		ph := clamp(PHValue, 0.0, 14.0)

		if ph <= 2.0 {
			// Very acidic: Deep red
			phColor = vec3(0.8, 0.1, 0.1)
		} else if ph <= 4.0 {
			// Acidic: Red to orange
			t := (ph - 2.0) / 2.0
			phColor = mix(vec3(0.8, 0.1, 0.1), vec3(1.0, 0.5, 0.0), t)
		} else if ph <= 6.0 {
			// Mildly acidic: Orange to yellow
			t := (ph - 4.0) / 2.0
			phColor = mix(vec3(1.0, 0.5, 0.0), vec3(1.0, 1.0, 0.2), t)
		} else if ph <= 8.0 {
			// Neutral range: Yellow to green
			t := (ph - 6.0) / 2.0
			phColor = mix(vec3(1.0, 1.0, 0.2), vec3(0.2, 0.8, 0.2), t)
		} else if ph <= 10.0 {
			// Mildly basic: Green to blue
			t := (ph - 8.0) / 2.0
			phColor = mix(vec3(0.2, 0.8, 0.2), vec3(0.2, 0.5, 1.0), t)
		} else if ph <= 12.0 {
			// Basic: Blue to purple
			t := (ph - 10.0) / 2.0
			phColor = mix(vec3(0.2, 0.5, 1.0), vec3(0.6, 0.2, 0.8), t)
		} else {
			// Very basic: Deep purple
			phColor = vec3(0.5, 0.1, 0.6)
		}

		// Apply the pH color to the original texture
		color.rgb *= phColor
    }
    return color
}
