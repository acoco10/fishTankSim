//kage:unit pixels
package main

var LightPoint vec2
var ImgRect vec4
var LightIntensity float // 0.0 = off, 1.0 = full brightness

func Fragment(dstCoord vec4, texCoord vec2, _ vec4) vec4 {
	color := imageSrc0UnsafeAt(texCoord)

	if color.a > 0 {
		// Distance from pixel to light (in screen space)
		dis := distance(LightPoint, dstCoord.xy)

		// Brightness modifier: closer to light = brighter
		brightness := clamp(1.0 - dis / 600.0, 0.0, 1.0)

		// Apply light intensity animation
		animatedBrightness := brightness * LightIntensity

		// Increase blue tones and brightness
		color.rgb += vec3(0.85, 0.1, 0.2) * animatedBrightness   // Add blue tint
		if LightIntensity < 0.01{
	    	color.rgb *= 0.09
	    	return color
		}
		 color.a *= 0.4

	}

	return color
}