//kage:unit pixels
package main

var OutlineColor vec4
var OutlineColor2 vec4
var Cursor vec3 
var Counter int

func Fragment(_ vec4, texCoord vec2, _ vec4) vec4 {
	color := imageSrc0UnsafeAt(texCoord)
    outline := false
	if color.a == 0.0 {
            for x := -1; x <= 1; x++ {
                for y := -1; y <= 1; y++ {
                    if x == 0 && y == 0 {
                        continue
                    }
                    sampleCoord := texCoord + vec2(float(x), float(y))
                    sample := imageSrc0UnsafeAt(sampleCoord)
                    if sample.a != 0 {
                        outline = true
                    }
                }
           }
    }

    pos := dstPos.xy - imageDstOrigin()
    	lightdir := normalize(Cursor - vec3(pos, 0))


    	srcNormal := imageSrc1UnsafeAt(texCoord)
        normal := normalize(vec3(srcNormal.r, 1.0 - srcNormal.g, srcNormal.b) - 0.5)
    	const ambient = 0.9
    	diffuse := 0.75 * max(0.0, dot(normal.xyz, lightdir))

    	// You can treat multiple source images by
    	// imageSrc[N]At or imageSrc[N]UnsafeAt.

        baseColor := imageSrc0UnsafeAt(texCoord)
        litRGB := baseColor.rgb * (ambient + diffuse)

    	color := vec4(litRGB, baseColor.a)
        outline := false

    if outline{
        if Counter > 20 {
            return OutlineColor2
        }
        return OutlineColor
    }

    return color
}
